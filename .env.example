# Copy this file to `.env` and fill it in. `.env` is never committed and never
# leaves your machine — Shipyard treats it as secret material and will not read
# values out of it, put it in a support bundle, or send it anywhere.

# Where your database lives. Shipyard runs one locally for you.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"

# The address the app is served from. Used to build links in emails.
APP_URL="http://localhost:3000"

# How many wrong passwords before an account is locked for a while. (optional)
AUTH_LOCKOUT_MAX_ATTEMPTS=5

# Which service sends your email. Leave it as console until you have an account. (optional)
EMAIL_PROVIDER=console

# The key from your email provider. (optional)
# Get it from: your email provider's dashboard
EMAIL_API_KEY=

# The address your emails come from. It has to be one your provider has verified. (optional)
EMAIL_FROM=noreply@example.com

# Outside production, only these addresses can be emailed. Comma separated. (optional)
EMAIL_ALLOWLIST=
